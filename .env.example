# Copy to .env and fill in. Never commit .env.

# "openrouter" (default) or "anthropic"
LLM_PROVIDER=openrouter

# --- OpenRouter: https://openrouter.ai/keys ---
OPENROUTER_API_KEY=sk-or-...
# Any model id from: python -m scripts.openrouter_models
#   anthropic/claude-haiku-5.5   cheap, strong default
#   anthropic/claude-sonnet-5.5  quality comparison
#   google/gemini-3.8-flash      cross-provider comparison
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Anthropic direct (only if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
